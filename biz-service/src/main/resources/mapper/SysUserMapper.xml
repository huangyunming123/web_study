<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.biz.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.demo.biz.entity.SysUser">
        <id column="id" property="id" />
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="nickname" property="nickname" />
        <result column="phone" property="phone" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, nickname, phone, status, create_time
    </sql>

    <!-- 分页查询用户 (支持 username, nickname, phone 模糊搜索，按 id 升序) -->
    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM sys_user
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    username LIKE CONCAT('%', #{keyword}, '%')
                    OR nickname LIKE CONCAT('%', #{keyword}, '%')
                    OR phone LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
        ORDER BY id ASC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 统计总条数 -->
    <select id="selectPageCount" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM sys_user
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    username LIKE CONCAT('%', #{keyword}, '%')
                    OR nickname LIKE CONCAT('%', #{keyword}, '%')
                    OR phone LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </select>

    <!-- 根据 ID 查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM sys_user
        WHERE id = #{id}
    </select>

    <!-- 更新用户昵称/展示名称 -->
    <update id="updateNickname">
        UPDATE sys_user
        SET nickname = #{nickname}
        WHERE id = #{id}
    </update>

    <!-- 更新用户状态 -->
    <update id="updateStatus">
        UPDATE sys_user
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <!-- 物理删除用户 -->
    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

</mapper>
