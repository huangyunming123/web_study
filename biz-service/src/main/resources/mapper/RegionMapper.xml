<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.biz.mapper.RegionMapper">

    <resultMap id="BaseResultMap" type="com.demo.biz.entity.Region">
        <id column="id" property="id" />
        <result column="parent_id" property="parentId" />
        <result column="name" property="name" />
        <result column="level" property="level" />
    </resultMap>

    <sql id="Base_Column_List">
        id, parent_id, name, level
    </sql>

    <!-- 查询全部行政地区 (按 id 升序) -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM region
        ORDER BY id ASC
    </select>

    <!-- 根据 ID 查询地区 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM region
        WHERE id = #{id}
    </select>

    <!-- 统计下级子地区数量 -->
    <select id="countByParentId" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM region
        WHERE parent_id = #{parentId}
    </select>

    <!-- 新增地区 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO region (parent_id, name, level)
        VALUES (#{parentId}, #{name}, #{level})
    </insert>

    <!-- 更新地区 -->
    <update id="update">
        UPDATE region
        <set>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="level != null">level = #{level},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 物理删除地区 -->
    <delete id="deleteById">
        DELETE FROM region WHERE id = #{id}
    </delete>

</mapper>
