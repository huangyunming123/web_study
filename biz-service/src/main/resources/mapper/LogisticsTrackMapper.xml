<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.biz.mapper.LogisticsTrackMapper">

    <resultMap id="BaseResultMap" type="com.demo.biz.entity.CrmLogisticsTrack">
        <id column="id" property="id" />
        <result column="order_no" property="orderNo" />
        <result column="tracking_no" property="trackingNo" />
        <result column="content" property="content" />
        <result column="location" property="location" />
        <result column="operator" property="operator" />
        <result column="track_time" property="trackTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, order_no, tracking_no, content, location, operator, track_time
    </sql>

    <!-- 根据订单号查询全部轨迹节点 (按时间顺序排列) -->
    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM crm_logistics_track
        WHERE order_no = #{orderNo}
        ORDER BY track_time ASC, id ASC
    </select>

    <!-- 根据运单号查询全部轨迹节点 -->
    <select id="selectByTrackingNo" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM crm_logistics_track
        WHERE tracking_no = #{trackingNo}
        ORDER BY track_time ASC, id ASC
    </select>

    <!-- 插入轨迹记录 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO crm_logistics_track (order_no, tracking_no, content, location, operator, track_time)
        VALUES (#{orderNo}, #{trackingNo}, #{content}, #{location}, #{operator}, #{trackTime})
    </insert>

</mapper>
