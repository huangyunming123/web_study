# 统一文本文件换行符，消除 Windows 下的 LF/CRLF 警告
* text=auto

# Java / 配置 / 脚本：仓库内统一 LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
.gitignore text eol=lf
*.conf text eol=lf

# Windows 批处理必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
